# Public env vars that the Vite client bundle reads. Copy to .env.local
# (gitignored) and adjust per environment.

# Google Analytics 4 Measurement ID (semi-público, pero lo leemos de env para
# poder rotarlo sin commitear cambios)
VITE_GA_MEASUREMENT_ID=G-E7GPE100LK

# Dashboard al que mandamos al lead después de activar el trial
VITE_APP_DASHBOARD_URL=https://app.deenex.tech

# Link de agendamiento del CSM (Calendly / Cal.com)
VITE_CALENDAR_URL=https://cal.com/deenex/onboarding
